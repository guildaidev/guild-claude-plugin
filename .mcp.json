{
  "mcpServers": {
    "guild": {
      "type": "http",
      "url": "https://api.guild.ai/mcp",
      "headers": {
        "X-Guild-MCP-Result-Format": "compact"
      }
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/readonly",
      "headers": {
        "X-MCP-Tools": "get_file_contents"
      }
    }
  }
}
